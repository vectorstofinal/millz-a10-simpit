---
import Base from '../../layouts/Base.astro';
import FileList from '../../components/FileList.astro';
import { getCollection, render } from 'astro:content';
import { byId } from '../../data/files';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, prev: posts[i - 1], next: posts[i + 1] } }));
}
const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const files = post.data.files.map((id) => { const f = byId(id); if (!f) throw new Error(`Unknown file id "${id}" in ${post.id}`); return f; });
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={post.data.title} description={post.data.summary}>
  <article class="article">
    <header>
      <a class="eyebrow" href="/" style="text-decoration:none">&larr; Build log</a>
      <h1>{post.data.title}</h1>
      <div class="meta">
        <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        {post.data.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>
    <div class="prose"><Content /></div>
    {files.length > 0 && (
      <section class="filebox" aria-labelledby="fh">
        <h2 id="fh">Files from this post</h2>
        <FileList items={files} />
      </section>
    )}
    <nav class="pager" aria-label="More posts">
      {prev ? <a href={`/posts/${prev.id}/`}><small>Earlier</small>{prev.data.title}</a> : <span />}
      {next ? <a href={`/posts/${next.id}/`} style="text-align:right"><small>Later</small>{next.data.title}</a> : <span />}
    </nav>
  </article>
</Base>
